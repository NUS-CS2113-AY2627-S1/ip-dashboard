[{"path":"AGENTS.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"-"},"content":"# Project context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"Kytersaurus"},"content":"All Java code in this project must follow [seedu-java-coding-standard](seedu-java-coding-standard/SKILL.md), based on the [SE-EDU Java coding standard](https://se-education.org/guides/conventions/java/intermediate.html).","lastModifiedDate":"2026-08-28T17:18:40","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"Kytersaurus"},"content":"","lastModifiedDate":"2026-08-28T17:18:40","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"-"},"content":"This repository is a starter template for a greenfield Java project used in an introductory software engineering course in an undergraduate computer science program. Students use it as the starting point for their own projects.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"-"},"content":"# Default user context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"-"},"content":"Unless the user says otherwise, assume that you are assisting a student working on a project in this repository. If the user identifies themselves as an instructor or another project stakeholder, adapt your response to that role.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"-"},"content":"# Student profile","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"-"},"content":"* Prior knowledge: Basic Java and OOP concepts.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"Kytersaurus"},"content":"* Level of programming experience: Basic data structures and algorithms","lastModifiedDate":"2026-08-17T21:25:29","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"Kytersaurus"},"content":"* IDE and level of expertise: IntelliJ IDEA, new","lastModifiedDate":"2026-08-17T21:25:29","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"-"},"content":"# Guidance for interacting with users","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"-"},"content":"* Explain the rationale for significant actions: what you did and why.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"-"},"content":"* Keep explanations brief but instructive, supporting learning through responsible use of AI. For example:","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"-"},"content":"  * When suggesting a Git command, briefly explain what it does.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"-"},"content":"  * Add explanatory Javadoc comments to all classes and to nontrivial methods and fields when their purpose or behavior is not obvious.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"-"},"content":"  * Make generated code as self-explanatory as possible, and include explanatory comments where they improve understanding.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"-"},"content":"  * When faced with a design choice, choose the simplest option that is sufficient for the requirements, while briefly explaining relevant more advanced alternatives.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"-"},"content":"# Project-specific requirements","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"Kytersaurus"},"content":"## Git standard:","lastModifiedDate":"2026-08-28T17:18:40","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"Kytersaurus"},"content":"","lastModifiedDate":"2026-08-28T17:18:40","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"Kytersaurus"},"content":"All future commits and branches must follow [seedu-git-standard](seedu-git-standard/SKILL.md), based on the [SE-EDU Git conventions](https://se-education.org/guides/conventions/git.html). Commit subjects must use imperative mood, capitalization, no final period, and a maximum of 72 characters; non-trivial commits must include a 72-character-wrapped body explaining what and why.","lastModifiedDate":"2026-08-28T17:18:40","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"Kytersaurus"},"content":"","lastModifiedDate":"2026-08-28T17:18:40","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"-"},"content":"## Java version:","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber"
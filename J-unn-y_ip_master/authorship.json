[{"path":".agents/skills/seedu-git-standard/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"J-unn-y"},"content":"---","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"J-unn-y"},"content":"name: seedu-git-standard","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"J-unn-y"},"content":"description: Apply the SE-EDU Git conventions when proposing or creating commits, writing commit messages, or naming branches in this project.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"J-unn-y"},"content":"---","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"J-unn-y"},"content":"# SE-EDU Git Standard","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"J-unn-y"},"content":"Follow the [SE-EDU Git conventions](https://se-education.org/guides/conventions/git.html) whenever proposing or","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"J-unn-y"},"content":"creating a commit, writing a commit message, or naming a branch in this project.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"J-unn-y"},"content":"This skill controls formatting and content only. It does not authorize creating a commit, pushing changes, or","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"J-unn-y"},"content":"creating a branch. Obtain any authorization required by the project instructions or user request.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"J-unn-y"},"content":"## Commit subject","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"J-unn-y"},"content":"- Write a meaningful subject for every commit.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"J-unn-y"},"content":"- Aim for at most 50 characters; never exceed 72 characters.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"J-unn-y"},"content":"- Use the imperative mood, such as `Add README.md` rather than `Added README.md`.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"J-unn-y"},"content":"- Capitalize the first letter.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"J-unn-y"},"content":"- Do not end with a period.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"J-unn-y"},"content":"- Add a useful `\u003cscope\u003e:` or `\u003ccategory\u003e:` prefix when it improves clarity.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"J-unn-y"},"content":"## Commit body","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"J-unn-y"},"content":"For every non-trivial commit, include a body that:","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"J-unn-y"},"content":"- is separated from the subject by one blank line;","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"J-unn-y"},"content":"- wraps at 72 characters;","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"J-unn-y"},"content":"- uses blank lines between paragraphs and bullet points where they improve readability;","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"J-unn-y"},"content":"- explains what changed and why, leaving implementation details to the diff;","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"J-unn-y"},"content":"- gives enough context for a reviewer to judge the change without reading the diff; and","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"J-unn-y"},"content":"- avoids repeating information already captured in code comments.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"J-unn-y"},"content":"When a longer explanation is useful, organize it around the present situation, why it needs to change, what the","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"J-unn-y"},"content":"commit does, why that approach was chosen, and any other relevant context. If the body becomes unwieldy, consider","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"J-unn-y"},"content":"whether the change should be split into smaller coherent commits.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"J-unn-y"},"content":"Before proposing or creating the message, inspect the actual staged or intended diff so every claim matches the","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":39,"author":{"gitId":"J-unn-y"},"content":"commit content. Do not include unrelated changes in the message.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":40,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":41,"author":{"gitId":"J-unn-y"},"content":"## Branch names","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":42,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":43,"author":{"gitId":"J-unn-y"},"content":"- Use meaningful keywords in kebab-case, such as `refactor-ui-tests`.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":44,"author":{"gitId":"J-unn-y"},"content":"- For an issue-related branch, use `issueNumber-keywords-from-title`, such as `1234-ui-freeze-error`.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":45,"author":{"gitId":"J-unn-y"},"content":"- Preserve any branch prefix required by the execution environment; apply these rules to the part after the prefix.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false}],"authorContributionMap":{"J-unn-y":45}},{"path":".agents/skills/seedu-java-coding-standard/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"J-unn-y"},"content":"---","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"J-unn-y"},"content":"name: seedu-java-coding-standard","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"J-unn-y"},"content":"description: Apply the SE-EDU Java coding standard (basic and intermediate rules) when creating, modifying, reviewing, or explaining Java code in this project.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"J-unn-y"},"content":"---","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"J-unn-y"},"content":"# SE-EDU Java Coding Standard","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"J-unn-y"},"content":"Apply the basic and intermediate rules from the","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"J-unn-y"},"content":"[SE-EDU Java coding standard](https://se-education.org/guides/conventions/java/intermediate.html) to every Java","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"J-unn-y"},"content":"file created, modified, or reviewed in this project.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"J-unn-y"},"content":"Before working on Java code, read [references/rules.md](references/rules.md) completely. Treat those rules as","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"J-unn-y"},"content":"mandatory. For topics they do not cover, follow the","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"J-unn-y"},"content":"[Google Java Style Guide](https://google.github.io/styleguide/javaguide.html), as directed by SE-EDU.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"J-unn-y"},"content":"When changing existing code:","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"J-unn-y"},"content":"1. Keep all new and edited code compliant.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"J-unn-y"},"content":"2. Correct nearby violations when doing so is safe and relevant to the requested change.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"J-unn-y"},"content":"3. When asked for a project-wide compliance update, audit every Java source and test file.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"J-unn-y"},"content":"4. Preserve behavior unless the task explicitly requires a behavior change.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"J-unn-y"},"content":"5. Compile and run relevant tests after formatting or structural changes.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"J-unn-y"},"content":"In the final response, mention any significant compliance-driven structural change, such as adding packages or","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"J-unn-y"},"content":"renaming identifiers.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false}],"authorContributionMap":{"J-unn-y":25}},{"path":".agents/skills/seedu-java-coding-standard/references/rules.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"J-unn-y"},"content":"# SE-EDU Java coding rules: basic and intermediate","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"J-unn-y"},"content":"This is an operational summary of the","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"J-unn-y"},"content":"[authoritative basic + intermediate standard](https://se-education.org/guides/conventions/java/intermediate.html).","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"J-unn-y"},"content":"Consult the authoritative page if a rule\u0027s application is ambiguous. Use the Google Java Style Guide for topics","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"J-unn-y"},"content":"not covered here.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"J-unn-y"},"content":"## Naming","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"J-unn-y"},"content":"- Use lowercase package names. For a school project, start package names with the project or group name, followed","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"J-unn-y"},"content":"  by logical group names; do not imply that NUS produced the code.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"J-unn-y"},"content":"- Use English noun names in `PascalCase` for classes and enums.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"J-unn-y"},"content":"- Use English verb names in `camelCase` for methods.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"J-unn-y"},"content":"- Use `camelCase` for variables and `SCREAMING_SNAKE_CASE` for constants.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"J-unn-y"},"content":"- Keep acronyms lowercase within identifiers, such as `exportHtmlSource`, not `exportHTMLSource`.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"J-unn-y"},"content":"- Give wide-scope variables descriptive names; short scratch names such as `i`, `j`, and `k` are acceptable in a","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"J-unn-y"},"content":"  small scope. Reserve `j` and `k` for nested loops.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"J-unn-y"},"content":"- Name booleans to read as booleans, preferably with prefixes such as `is`, `has`, `was`, `can`, or `should`.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"J-unn-y"},"content":"- Use plural names for collections and arrays.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"J-unn-y"},"content":"- Give associated constants a common prefix.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"J-unn-y"},"content":"- Test methods may use `featureUnderTest_testScenario_expectedBehavior`, omitting later parts when unnecessary.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"J-unn-y"},"content":"## Layout","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"J-unn-y"},"content":"- Indent using four spaces, never tabs.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"J-unn-y"},"content":"- Prefer lines shorter than 110 characters and never exceed 120 characters. Indent continuation lines eight spaces","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"J-unn-y"},"content":"  beyond their parent line.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"J-unn-y"},"content":"- Wrap for readability: break after commas and before operators, including `.`, `\u0026`, and `|`. Keep a method or","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"J-unn-y"},"content":"  constructor name attached to its opening parenthesis and prefer higher-level expression breaks.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"J-unn-y"},"content":"- Use K\u0026R braces. Always use braces for loop and conditional bodies, even for one statement, and put the body on a","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"J-unn-y"},"content":"  separate line.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"J-unn-y"},"content":"- Put spaces around operators, after Java keywords and commas, around ternary colons, and after semicolons in","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"J-unn-y"},"content":"  `for` headers.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"J-unn-y"},"content":"- Separate logical units within a block with one blank line.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"J-unn-y"},"content":"- Follow the standard forms for methods, `if`/`else`, loops, `switch`, and `try`/`catch`. Add `// Fallthrough` when","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"J-unn-y"},"content":"  a colon-style switch case intentionally falls through.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"J-unn-y"},"content":"## Packages, imports, types, and variables","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":39,"author":{"gitId":"J-unn-y"},"content":"","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":40,"author":{"gitId":"J-unn-y"},"content":"- Put every class in a package.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":41,"author":{"gitId":"J-unn-y"},"content":"- Keep import ordering consistent. List each imported class explicitly; never use wildcard imports.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":42,"author":{"gitId":"J-unn-y"},"content":"- Attach array brackets to the type, such as `Task[] tasks`.","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit":false},{"lineNumber":43,"author":{"gitId":"J-unn-y"},"content":"- Initialize variables where declared and declare them in the smallest possible scope. If no valid initial value","lastModifiedDate":"2026-08-27T21:30:54","isFullCredit"
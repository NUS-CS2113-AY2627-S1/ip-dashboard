iedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":64,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":65,"author":{"gitId":"Rixte"},"content":"- Use 4 spaces for indentation. Do not use tabs.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":66,"author":{"gitId":"Rixte"},"content":"- Keep lines at or below 120 characters.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":67,"author":{"gitId":"Rixte"},"content":"- Use one statement per line.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":68,"author":{"gitId":"Rixte"},"content":"- Use braces consistently for control structures.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":69,"author":{"gitId":"Rixte"},"content":"- Keep related code together and use blank lines to separate logical sections.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":70,"author":{"gitId":"Rixte"},"content":"- Do not leave unnecessary trailing whitespace.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":71,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":72,"author":{"gitId":"Rixte"},"content":"## Naming","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":73,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":74,"author":{"gitId":"Rixte"},"content":"- Classes and interfaces use PascalCase.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":75,"author":{"gitId":"Rixte"},"content":"- Methods and variables use camelCase.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":76,"author":{"gitId":"Rixte"},"content":"- Constants use UPPER_SNAKE_CASE.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":77,"author":{"gitId":"Rixte"},"content":"- Names should be descriptive and avoid unnecessary abbreviations.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":78,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":79,"author":{"gitId":"Rixte"},"content":"## Comments and Javadoc","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":80,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":81,"author":{"gitId":"Rixte"},"content":"- Write comments in English.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":82,"author":{"gitId":"Rixte"},"content":"- Public classes and public methods should have Javadoc where required by the convention.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":83,"author":{"gitId":"Rixte"},"content":"- Comments should explain intent or rationale rather than simply restating code.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":84,"author":{"gitId":"Rixte"},"content":"- Avoid unnecessary comments.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":85,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":86,"author":{"gitId":"Rixte"},"content":"## Classes","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":87,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":88,"author":{"gitId":"Rixte"},"content":"- Keep each top-level class in its own file.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":89,"author":{"gitId":"Rixte"},"content":"- The filename must match the public class name.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":90,"author":{"gitId":"Rixte"},"content":"- Use appropriate access modifiers.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":91,"author":{"gitId":"Rixte"},"content":"- Keep fields private/protected only when justified by the design.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":92,"author":{"gitId":"Rixte"},"content":"- Prefer encapsulation through methods rather than exposing mutable state directly.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":93,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":94,"author":{"gitId":"Rixte"},"content":"## Packages","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":95,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":96,"author":{"gitId":"Rixte"},"content":"- Java source files should declare an appropriate package.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":97,"author":{"gitId":"Rixte"},"content":"- The package declaration should match the project\u0027s directory structure.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":98,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":99,"author":{"gitId":"Rixte"},"content":"## General","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":100,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":101,"author":{"gitId":"Rixte"},"content":"- Follow the official SE-EDU Java Intermediate Coding Standard:","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":102,"author":{"gitId":"Rixte"},"content":"  https://se-education.org/guides/conventions/java/intermediate.html","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":103,"author":{"gitId":"Rixte"},"content":"- When a project-specific requirement conflicts with a general style rule, satisfy the project requirement while keeping the rest of the code compliant.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":104,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":105,"author":{"gitId":"Rixte"},"content":"## SEEDU Git Commit Standard:","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":106,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":107,"author":{"gitId":"Rixte"},"content":"All Git commits in this project must follow the SE-EDU Git conventions.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":108,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":109,"author":{"gitId":"Rixte"},"content":"## Commit subject","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":110,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":111,"author":{"gitId":"Rixte"},"content":"- Use an imperative mood.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":112,"author":{"gitId":"Rixte"},"content":"- Capitalize the first word.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":113,"author":{"gitId":"Rixte"},"content":"- Do not end the subject with a period.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":114,"author":{"gitId":"Rixte"},"content":"- Keep the subject line preferably within 50 characters.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":115,"author":{"gitId":"Rixte"},"content":"- Never exceed 72 characters.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":116,"author":{"gitId":"Rixte"},"content":"- The subject should clearly describe the change.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":117,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":118,"author":{"gitId":"Rixte"},"content":"## Commit body","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":119,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":120,"author":{"gitId":"Rixte"},"content":"- For non-trivial changes, include a body explaining what changed and why.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":121,"author":{"gitId":"Rixte"},"content":"- Separate the subject from the body with a blank line.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":122,"author":{"gitId":"Rixte"},"content":"- Wrap body lines at approximately 72 characters.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":123,"author":{"gitId":"Rixte"},"content":"- Focus on rationale and relevant context rather than repeating the diff.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":124,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":125,"author":{"gitId":"Rixte"},"content":"## Commit scope","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":126,"author":{"gitId":"Rixte"},"content":"","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":127,"author":{"gitId":"Rixte"},"content":"- Each commit should represent one logical change.","lastModifiedDate":"2026-08-26T00:23:05","isFullCredit":false},{"lineNumber":128,"author":{"gitId":"Rixte"},"content":"- Do not combine unrelated changes into one commit.","last
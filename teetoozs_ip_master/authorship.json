teetoozs":32}},{"path":".codex/skills/seedu-git-standard/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"teetoozs"},"content":"---","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"teetoozs"},"content":"name: seedu-git-standard","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"teetoozs"},"content":"description: Apply the SE-EDU Git conventions when proposing commit messages, creating commits, naming branches, or reviewing Git history in this project.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"teetoozs"},"content":"---","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"teetoozs"},"content":"# SE-EDU Git Standard","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"teetoozs"},"content":"Follow the current [SE-EDU Git conventions](https://se-education.org/guides/conventions/git.html).","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"teetoozs"},"content":"For commit messages:","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"teetoozs"},"content":"- Write a clear subject in imperative mood.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"teetoozs"},"content":"- Capitalize the subject and do not end it with a period.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"teetoozs"},"content":"- Aim for 50 characters and never exceed 72 characters.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"teetoozs"},"content":"- Add an optional scope or category prefix only when it improves clarity.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"teetoozs"},"content":"- For non-trivial commits, separate the body with a blank line and wrap body lines at 72 characters.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"teetoozs"},"content":"- Explain what situation motivates the change, why it matters, what the commit changes, and why that approach is suitable. Let the diff explain implementation details.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"teetoozs"},"content":"- Split unrelated or overly broad changes into focused commits.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"teetoozs"},"content":"For branch names, use meaningful kebab-case words. Prefix issue-related branches with the issue number when applicable.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"teetoozs"},"content":"Before committing, inspect the staged diff, confirm it contains one coherent change, and check the complete message against these rules.","lastModifiedDate":"2026-08-22T14:24:37","isFullCredit":false}],"authorContributionMap":{"teetoozs":22}},{"path":".codex/skills/seedu-java-coding-standard/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"teetoozs"},"content":"---","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"teetoozs"},"content":"name: seedu-java-coding-standard","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"teetoozs"},"content":"description: Apply the SE-EDU basic and intermediate Java coding standard when writing, editing, refactoring, or reviewing Java code in this project.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"teetoozs"},"content":"---","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"teetoozs"},"content":"# SE-EDU Java Coding Standard","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"teetoozs"},"content":"Follow the current [SE-EDU Java coding standard](https://se-education.org/guides/conventions/java/intermediate.html). Use Google Java Style only for topics the SE-EDU guide does not cover.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"teetoozs"},"content":"Apply these project-relevant rules:","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"teetoozs"},"content":"- Put every class in a package and keep the directory structure consistent with the package.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"teetoozs"},"content":"- Use nouns in PascalCase for classes, verbs in camelCase for methods, camelCase for variables, and SCREAMING_SNAKE_CASE for constants.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"teetoozs"},"content":"- Give boolean variables and methods names that read as booleans, such as `isDone` or `hasTasks`.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"teetoozs"},"content":"- Use plural names for collections and arrays.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"teetoozs"},"content":"- Indent with 4 spaces. Keep lines below 120 characters, preferably below 110, and indent wrapped lines by 8 additional spaces.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"teetoozs"},"content":"- Use K\u0026R braces, spaces around operators, spaces after commas, and braces for every loop and conditional body.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"teetoozs"},"content":"- Separate logical blocks with blank lines.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"teetoozs"},"content":"- Use explicit imports rather than wildcard imports, and keep import ordering consistent.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"teetoozs"},"content":"- Attach array brackets to the type. Initialize variables at declaration and declare them in the smallest useful scope.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"teetoozs"},"content":"- Keep fields non-public except constants.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"teetoozs"},"content":"- Write English comments using American spelling. Use comments to explain intent, not obvious mechanics.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"teetoozs"},"content":"- Write descriptive Javadocs for every public class and public method, except getters, setters, overrides whose inherited documentation applies, and test code. Use a multi-line Javadoc form for public APIs.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"teetoozs"},"content":"","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"teetoozs"},"content":"Before finishing, compile or test the affected Java code and review changed lines for these rules.","lastModifiedDate":"2026-08-22T14:24:02","isFullCredit":false}],"authorContributionMap":{"teetoozs":25}},{"path":"AGENTS.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"-"},"content":"# Project context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"-"},"content":"This repository is a starter template for a greenfield Java project used in an introductory software engineering course in an undergraduate computer science program. Students use it as the starting point for their own projects.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"-"},"content":"# Default user context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"-"},"content":"Unless the user says otherwise, assu
[{"path":".codex/skills/seedu-git-standard/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"Darren50"},"content":"---","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"Darren50"},"content":"name: seedu-git-standard","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"Darren50"},"content":"description: Apply the SE-EDU Git conventions for commit messages and branch names when proposing, reviewing, or creating Git commits in this project.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"Darren50"},"content":"---","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"Darren50"},"content":"# SE-EDU Git Standard","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"Darren50"},"content":"Use this skill when proposing, reviewing, or creating Git commits in this project.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"Darren50"},"content":"Base decisions on the SE-EDU Git conventions:","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"Darren50"},"content":"https://se-education.org/guides/conventions/git.html","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"Darren50"},"content":"## Commit Subjects","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"Darren50"},"content":"- Write a clear subject line for every commit.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"Darren50"},"content":"- Use the imperative mood, such as `Add task list support`.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"Darren50"},"content":"- Capitalize the first letter.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"Darren50"},"content":"- Do not end the subject with a period.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"Darren50"},"content":"- Try to keep the subject under 50 characters. The hard limit is 72 characters.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"Darren50"},"content":"- Add a short scope or category prefix only when it improves clarity.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"Darren50"},"content":"## Commit Bodies","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"Darren50"},"content":"- Add a body for nontrivial commits.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"Darren50"},"content":"- Separate the subject and body with a blank line.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"Darren50"},"content":"- Wrap body lines at about 72 characters.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"Darren50"},"content":"- Explain what changed and why. Leave low-level implementation details to the diff.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"Darren50"},"content":"- Split changes into smaller commits when the body becomes too broad.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"Darren50"},"content":"## Commit Scope","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"Darren50"},"content":"- Keep each commit to one logical change.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"Darren50"},"content":"- For branch names, use meaningful kebab-case names, optionally prefixed by the issue number when relevant.","lastModifiedDate":"2026-08-27T17:30:25","isFullCredit":false}],"authorContributionMap":{"Darren50":32}},{"path":".codex/skills/seedu-java-coding-standard/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"Darren50"},"content":"---","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"Darren50"},"content":"name: seedu-java-coding-standard","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"Darren50"},"content":"description: Apply the SE-EDU Java coding standard for this project, including naming, layout, imports, packages, comments, and simple readable Java style.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"Darren50"},"content":"---","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"Darren50"},"content":"# SE-EDU Java Coding Standard","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"Darren50"},"content":"Use this skill when writing, editing, or reviewing Java code in this project.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"Darren50"},"content":"Base decisions on the SE-EDU Java coding standard:","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"Darren50"},"content":"https://se-education.org/guides/conventions/java/intermediate.html","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"Darren50"},"content":"For topics not covered by the SE-EDU guide, follow the Google Java Style Guide.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"Darren50"},"content":"## Core Rules","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"Darren50"},"content":"- Put every Java class in a package. Use a lowercase root package based on the project name, such as `gpt`.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"Darren50"},"content":"- Use PascalCase for class, enum, and interface names.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"Darren50"},"content":"- Treat acronyms as ordinary words in identifiers, such as `Gpt`, not `GPT`.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"Darren50"},"content":"- Use camelCase for variables and methods.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"Darren50"},"content":"- Use names that communicate purpose. Collection variables should normally be plural.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"Darren50"},"content":"- Use SCREAMING_SNAKE_CASE for constants.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"Darren50"},"content":"- Use explicit imports. Do not use wildcard imports.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"Darren50"},"content":"- Use 4 spaces for indentation and K\u0026R braces.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"Darren50"},"content":"- Keep lines under 120 characters, and prefer under 110 characters when practical.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"Darren50"},"content":"- Put spaces around operators, after commas, and after Java reserved words.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"Darren50"},"content":"- Use braces for all loop and conditional bodies, even single-line bodies.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"Darren50"},"content":"- Declare variables in the smallest reasonable scope and initialize them where declared.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"Darren50"},"content":"- Keep fields private unless there is a strong reason otherwise.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"Darren50"},"content":"## Comments And Javadocs","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"Darren50"},"content":"- Write comments and Javadocs in English, using American spelling and avoiding local slang.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"Darren50"},"content":"- Add Javadoc header comments for all public classes and public methods, except simple getters/setters, exact overrides, and test methods.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"Darren50"},"content":"- The first Javadoc sentence should be a short summary that starts naturally, such as `Returns ...`, `Adds ...`, or `Marks ...`.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"Darren50"},"content":"- Add `@param`, `@return`, and `@throws` only when they add useful information.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"Darren50"},"content":"- Use inline comments sparingly, when they explain intent that is not obvious from the code.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"Darren50"},"content":"## Review Focus","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":39,"author":{"gitId":"Darren50"},"content":"","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false},{"lineNumber":40,"author":{"gitId":"Darren50"},"content":"When reviewing Java changes, check package placement, naming, imports, layout, comments/Javadocs, visibility, line length, and whether the simplest sufficient design was used.","lastModifiedDate":"2026-08-27T17:30:10","isFullCredit":false}],"authorContributionMap":{"Darren50":40}},{"path":"AGENTS.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"-"},"content":"# Project context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"-"},"content":"This repository is a starter template for a greenfield Java project used in an introductory software engineering course in an undergraduate computer science program. Students use it as the starting point for their own projects.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"-"},"content":"# Default user context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"-"},"content":"Unless the user says otherwise, assume that you are assisting a student working on a project in this repository. If the user identifies themselves as an instructor or another project stakeholder, adapt your response to that role.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"-"},"content":"# Student profile","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lin